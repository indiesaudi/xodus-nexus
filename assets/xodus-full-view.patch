+    #[test]
+    fn full_view_materializes_every_encrypted_file_in_the_private_view_directory() {
+        let root = tempfile::tempdir().unwrap();
+        let source = root.path().join("game");
+        std::fs::create_dir_all(source.join("Bin")).unwrap();
+        std::fs::write(source.join("Game.exe"), b"encrypted launcher").unwrap();
+        std::fs::write(source.join("Bin/Code.dll"), b"encrypted code").unwrap();
+        std::fs::write(source.join("Bin/data.pak"), b"encrypted data").unwrap();
+        std::fs::write(source.join("Bin/assets.bin"), b"plain assets").unwrap();
+        let views = root.path().join("views");
+        private_directory(&views);
+
+        let mut exe = tempfile::tempfile().unwrap();
+        let mut dll = tempfile::tempfile().unwrap();
+        let mut data = tempfile::tempfile().unwrap();
+        exe.write_all(&fake_pe()).unwrap();
+        dll.write_all(&fake_pe()).unwrap();
+        data.write_all(b"decrypted data").unwrap();
+        let (exe_name, dll_name, data_name) = (String::from("Game.exe"), String::from("Bin\\Code.dll"), String::from("Bin\\data.pak"));
+        let files = [(&exe_name, exe.as_raw_fd()), (&dll_name, dll.as_raw_fd()), (&data_name, data.as_raw_fd())];
+
+        let (mirror, entry, count, bytes) = create_launch_view(&source, &exe_name, &files, true, Some(&views)).unwrap();
+        assert!(mirror.path().starts_with(&views));
+        assert_eq!(std::fs::metadata(mirror.path()).unwrap().mode() & 0o077, 0);
+        assert_eq!(entry, mirror.path().join("Game.exe"));
+        assert_eq!((count, bytes), (3, 2048 + 14));
+        assert_eq!(std::fs::read(mirror.path().join("Bin/Code.dll")).unwrap(), fake_pe());
+        assert_eq!(std::fs::read(mirror.path().join("Bin/data.pak")).unwrap(), b"decrypted data");
+        for real in ["Game.exe", "Bin/Code.dll", "Bin/data.pak"] {
+            assert!(std::fs::symlink_metadata(mirror.path().join(real)).unwrap().file_type().is_file());
+        }
+        assert!(std::fs::symlink_metadata(mirror.path().join("Bin/assets.bin")).unwrap().file_type().is_symlink());
+        assert_eq!(std::fs::read(source.join("Bin/Code.dll")).unwrap(), b"encrypted code");
+        drop(mirror);
+        assert_eq!(std::fs::read_dir(&views).unwrap().count(), 0);
+    }
