+// A full launch view must never be readable by other users: the directory that
+// holds it is an absolute, owner-only (0700), non-symlinked directory of ours.
+fn checked_view_directory(directory: &Path) -> std::io::Result<()> {
+    let denied = |message: &str| std::io::Error::new(std::io::ErrorKind::PermissionDenied, message.to_string());
+    if !directory.is_absolute() {
+        return Err(denied("the launch view directory must be an absolute path"));
+    }
+    let metadata = std::fs::symlink_metadata(directory)?;
+    if !metadata.file_type().is_dir() {
+        return Err(denied("the launch view directory is not a plain directory"));
+    }
+    // /proc/self belongs to this process's user; no extra nix/rustix features needed.
+    if metadata.uid() != std::fs::metadata("/proc/self")?.uid() || metadata.mode() & 0o077 != 0 {
+        return Err(denied("the launch view directory must be owned by this user with mode 0700"));
+    }
+    Ok(())
+}
+
+// Copies one decrypted image as is. Unlike the launch stub writer it accepts
+// encrypted files that are not PE images, which a full view must also contain.
+fn copy_decrypted_image(path: &Path, fd: RawFd) -> std::io::Result<u64> {
+    // Borrow the decrypted memfd without taking ownership; it is closed with the image.
+    let image = std::mem::ManuallyDrop::new(unsafe { std::fs::File::from_raw_fd(fd) });
+    let image_len = image.metadata()?.len();
+    let output = std::fs::OpenOptions::new().write(true).create_new(true).open(path)?;
+    let mut buffer = vec![0u8; 1024 * 1024];
+    let mut offset = 0u64;
+    while offset < image_len {
+        let bytes = (image_len - offset).min(buffer.len() as u64) as usize;
+        image.read_exact_at(&mut buffer[..bytes], offset)?;
+        output.write_all_at(&buffer[..bytes], offset)?;
+        offset += bytes as u64;
+    }
+    output.set_permissions(std::fs::Permissions::from_mode(0o700))?;
+    Ok(image_len)
+}
